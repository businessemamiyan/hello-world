{
  "log": { "loglevel": "warning" },
  "inbounds": [
    { "tag": "socks-in", "listen": "0.0.0.0", "port": 10808, "protocol": "socks", "settings": { "udp": false, "auth": "noauth" } }
  ],
  "outbounds": [
    {
      "tag": "relay",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "SERVER_ADDRESS",
            "port": 443,
            "users": [ { "id": "UUID", "encryption": "none", "flow": "xtls-rprx-vision" } ]
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "serverName": "SNI_DOMAIN",
          "fingerprint": "chrome",
          "publicKey": "PUBLIC_KEY",
          "shortId": "SHORT_ID"
        }
      }
    }
  ]
}
