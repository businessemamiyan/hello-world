# کپی کن به .env و پر کن. هیچ‌وقت .env را در گیت نگذار.

# توکن ربات از @BotFather (یک ربات تازه بساز، جدا از ربات قطب‌نما)
BOT_TOKEN=
# شناسه عددی تلگرام خودت (اختیاری). اگر خالی باشد، اولین «/start SETUP_CODE» صاحبش می‌شود.
OWNER_ID=
# کد یک‌بار مصرف برای معرفی خودت به مهرداد (مثلاً خروجی: openssl rand -hex 6)
SETUP_CODE=

# --- مغز: یکی از دو راه (BRAIN_PROVIDER=auto: اگر کلید API هست api، وگرنه cli) ---
# راه ۱ (بدون هزینهٔ API): اشتراک Claude خودت از طریق باینری رسمی Claude Code.
#   روی سیستم خودت (که مرورگر دارد) بزن:  claude setup-token   و توکن یک‌ساله را اینجا بگذار.
#   فقط برای استفادهٔ شخصی خودت؛ سقف مصرف همان سقف اشتراک توست.
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_CLI_MODEL=sonnet
# راه ۲ (پولی، pay-as-you-go): کلید API از https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
BRAIN_PROVIDER=auto

# روی سرور خارج از ایران (مثلاً هلند) پروکسی لازم نیست — این دو را خالی بگذار.
# فقط اگر سرور داخل ایران است و Xray داری، هر دو را فعال کن:
#   TELEGRAM_PROXY=socks5://xray:10808
#   ANTHROPIC_PROXY=socks5://xray:10808
TELEGRAM_PROXY=
ANTHROPIC_PROXY=

# پورت لوکال میزبان برای /health (فقط 127.0.0.1). اگر روی سرور اشغال بود عوضش کن.
HOST_PORT=8095

# ساعت یادآوری شبانه‌ی چک‌این عادت‌ها (وقت تهران)
HABIT_CHECKIN_TIME=21:00
# یا به‌جای پروکسی، یک رله/Worker که Bot API را فوروارد می‌کند:
# TELEGRAM_API_BASE=https://my-worker.example.workers.dev
