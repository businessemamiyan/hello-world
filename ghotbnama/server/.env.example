# کپی کن به .env و پر کن. هیچ‌وقت .env را در گیت نگذار.

# توکن ربات از @BotFather
BOT_TOKEN=
# شناسه عددی تلگرام خودت (اختیاری). اگر خالی باشد، اولین «/start SETUP_CODE» صاحب ربات می‌شود.
OWNER_ID=
# کد یک‌بار مصرف برای معرفی خودت به ربات (مثلاً خروجی: openssl rand -hex 6)
SETUP_CODE=
# مسیر مخفی دریافت پیامک: https://دامنه/sms/SMS_TOKEN   (openssl rand -hex 24)
SMS_TOKEN=
# کلید ورود به اپ از مرورگر (بیرون از تلگرام): https://دامنه/app?key=APP_KEY   (openssl rand -hex 24)
APP_KEY=
# آدرس عمومی HTTPS اپ (برای دکمه Mini App در تلگرام)
PUBLIC_URL=https://ghotb.example.ir
# دامنه برای Caddy (فقط اگر پروفایل https را روشن می‌کنی)
DOMAIN=ghotb.example.ir

# رسیدن به API تلگرام از ایران: پروکسی SOCKS5/HTTP
# با پروفایل proxy همین مقدار درست است:
TELEGRAM_PROXY=socks5://xray:10808
# یا به‌جای پروکسی، یک رله/Worker که Bot API را فوروارد می‌کند:
# TELEGRAM_API_BASE=https://my-worker.example.workers.dev

# زمان‌بندی یادآوری‌ها (وقت تهران)
MORNING=07:30
MIDDAY=13:00
EVENING=21:00
WEEKLY_TIME=19:00
# روز بازبینی هفتگی: 0=دوشنبه … 4=جمعه … 5=شنبه 6=یکشنبه
WEEKLY_WEEKDAY=4
