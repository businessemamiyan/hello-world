<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- فقط HTTPS؛ فقط برای آدرس‌هایی که کاربر خودش در تنظیمات وارد می‌کند وصل می‌شویم -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
